<%@ Page Title="My Dashboard" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="ClientDashboard.aspx.cs" Inherits="TheRanger.ClientDashboard" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><style>.dashboard-hero{background:linear-gradient(135deg,#10281c,#1d4a35);color:#fff;padding:60px 0}.dashboard-body{background:#f6f3ec;min-height:calc(100vh - 300px);padding:55px 0}.booking-card{background:#fff;border:1px solid #e6e0d4;border-radius:16px;padding:20px}.status{font-size:.72rem;font-weight:800;padding:.4rem .7rem;border-radius:99px}.status-pending{background:#fff3cd;color:#856404}.status-confirmed{background:#d1e7dd;color:#0f5132}.status-cancelled{background:#f8d7da;color:#842029}.status-completed{background:#cff4fc;color:#055160}.dashboard-money{white-space:nowrap}</style></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server"><section class="dashboard-hero"><div class="container"><div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-4"><div><div class="page-kicker">CLIENT DASHBOARD</div><h1 class="page-title">Welcome, <asp:Literal ID="litName" runat="server" />.</h1><p class="mb-0 opacity-75">Your safari plans, bookings and next adventure in one place.</p></div><div class="d-flex gap-2"><a href="Accommodation.aspx" class="btn btn-sand px-4">Find a stay</a><a href="GameDrives.aspx" class="btn btn-outline-light rounded-pill px-4">Book a drive</a><a href="Help.aspx" class="btn btn-outline-light rounded-pill px-4"><i class="fa-regular fa-circle-question me-1"></i> Help</a></div></div></div></section>
<section class="dashboard-body"><div class="container"><div class="row g-4 mb-5"><div class="col-md-4"><div class="stat-box h-100"><div class="feature-icon mb-3"><i class="fa-solid fa-bed"></i></div><div class="muted small">Accommodation bookings</div><div class="value"><asp:Literal ID="litAccommodationCount" runat="server" /></div></div></div><div class="col-md-4"><div class="stat-box h-100"><div class="feature-icon mb-3"><i class="fa-solid fa-binoculars"></i></div><div class="muted small">Game drive bookings</div><div class="value"><asp:Literal ID="litDriveCount" runat="server" /></div></div></div><div class="col-md-4"><div class="stat-box h-100"><div class="feature-icon mb-3"><i class="fa-solid fa-route"></i></div><div class="muted small">Active plans</div><div class="value"><asp:Literal ID="litActiveCount" runat="server" /></div></div></div></div>
<div id="bookings" class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="font-display mb-1">My bookings</h2><p class="muted mb-0">Manage your accommodation and game-drive reservations.</p></div></div>
<div class="row g-3"><asp:Repeater ID="rptBookings" runat="server" OnItemDataBound="rptBookings_ItemDataBound"><ItemTemplate><div class="col-12"><div class="booking-card"><div class="row align-items-center g-3"><div class="col-lg-4"><div class="small text-uppercase muted"><asp:Literal ID="litBookingType" runat="server" /></div><h5 class="mb-1"><asp:Literal ID="litItemName" runat="server" /></h5><div class="small muted"><i class="fa-solid fa-location-dot me-1"></i><asp:Literal ID="litLocation" runat="server" /></div></div><div class="col-lg-3"><div class="small muted">Dates</div><strong><asp:Literal ID="litDate" runat="server" /></strong><div class="small muted"><asp:Literal ID="litGuests" runat="server" /></div></div><div class="col-lg-2"><asp:Label ID="lblStatus" runat="server" /><div class="fw-bold mt-2 dashboard-money">R <asp:Literal ID="litTotal" runat="server" /></div></div><div class="col-lg-3 text-lg-end"><asp:LinkButton ID="btnCancel" runat="server" CssClass="btn btn-outline-danger rounded-pill btn-sm" CommandArgument='<%# Eval("BookingId") %>' OnCommand="CancelBooking_Command" OnClientClick="return window.confirm(&quot;Cancel this booking?&quot;);"><i class="fa-solid fa-xmark me-1"></i> Cancel booking</asp:LinkButton></div></div></div></div></ItemTemplate></asp:Repeater><asp:Panel ID="pnlEmpty" runat="server" CssClass="col-12 surface p-5 text-center" Visible="false"><i class="fa-solid fa-compass fs-2 mb-3" style="color:#8b6732"></i><h4 class="font-display">No bookings yet</h4><p class="muted">Choose a stay or game drive to start building your safari.</p><a href="Accommodation.aspx" class="btn btn-ranger">Explore accommodation</a></asp:Panel></div></div></section></asp:Content>
