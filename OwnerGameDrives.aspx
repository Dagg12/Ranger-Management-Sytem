<%@ Page Title="Manage Game Drives" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="OwnerGameDrives.aspx.cs" Inherits="TheRanger.OwnerGameDrives" %>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container"><div class="mb-4"><div class="page-kicker">OWNER INVENTORY</div><h1 class="page-title text-dark">Game Drives</h1><p class="muted">Add, edit, hide and assign images to your guided drives.</p></div><div class="row g-4"><div class="col-lg-5"><div class="surface p-4"><h3 class="font-display"><asp:Literal ID="litFormTitle" runat="server">Add game drive</asp:Literal></h3><asp:Label ID="lblMessage" runat="server" CssClass="d-block mb-3"></asp:Label><asp:HiddenField ID="hfId" runat="server" /><label class="form-label">Drive name</label><asp:TextBox ID="txtName" runat="server" CssClass="form-control mb-3"></asp:TextBox><label class="form-label">Description</label><asp:TextBox ID="txtDescription" runat="server" TextMode="MultiLine" Rows="3" CssClass="form-control mb-3"></asp:TextBox><label class="form-label">Location</label><asp:DropDownList ID="ddlLocation" runat="server" CssClass="form-select mb-2"></asp:DropDownList><asp:TextBox ID="txtNewLocation" runat="server" CssClass="form-control mb-3" placeholder="Or enter a new location"></asp:TextBox><div class="row"><div class="col-4"><label class="form-label">Hours</label><asp:TextBox ID="txtDuration" runat="server" CssClass="form-control mb-3"></asp:TextBox></div><div class="col-4"><label class="form-label">Price</label><asp:TextBox ID="txtPrice" runat="server" CssClass="form-control mb-3"></asp:TextBox></div><div class="col-4"><label class="form-label">Guests</label><asp:TextBox ID="txtMax" runat="server" TextMode="Number" CssClass="form-control mb-3"></asp:TextBox></div></div><label class="form-label">Existing image</label><asp:DropDownList ID="ddlImage" runat="server" CssClass="form-select mb-2"></asp:DropDownList><small class="muted d-block mb-3">Choose an existing image or upload a new one.</small><asp:FileUpload ID="fuImage" runat="server" CssClass="form-control mb-3" accept=".jpg,.jpeg,.png,.webp,.avif" /><div class="form-check mb-3"><asp:CheckBox ID="chkAvailable" runat="server" Checked="true" CssClass="form-check-input" /><label class="form-check-label" for="MainContent_chkAvailable">Available for booking</label></div><asp:Button ID="btnSave" runat="server" Text="Save game drive" CssClass="btn btn-ranger w-100" OnClick="btnSave_Click" /><asp:Button ID="btnClear" runat="server" Text="Clear form" CssClass="btn btn-outline-secondary rounded-pill w-100 mt-2" OnClick="btnClear_Click" /></div></div><div class="col-lg-7"><div class="surface table-ranger"><div class="p-4"><h3 class="font-display mb-0">Your drives</h3></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Drive</th><th>Location</th><th>Rate</th><th>Status</th><th></th></tr></thead><tbody><asp:Repeater ID="rptItems" runat="server"><ItemTemplate><tr><td><strong><%# Eval("drive_name") %></strong><div class="small muted"><%# Eval("duration_hours") %> hours · <%# Eval("max_guests") %> guests</div></td><td><%# Eval("location") %></td><td>R <%# Eval("price","{0:N2}") %></td><td><span class="badge-soft"><%# Convert.ToBoolean(Eval("available"))?"Available":"Hidden" %></span></td><td class="text-end"><a class="btn btn-sm btn-outline-dark rounded-pill" href='OwnerGameDrives.aspx?edit=<%# Eval("game_drive_id") %>'>Edit</a><asp:LinkButton ID="btnDelete" runat="server" CssClass="btn btn-sm btn-outline-danger rounded-pill ms-1" CommandArgument='<%# Eval("game_drive_id") %>' OnCommand="Delete_Command" OnClientClick="return confirm('Delete this drive?');">Delete</asp:LinkButton></td></tr></ItemTemplate></asp:Repeater></tbody></table></div></div></div></div></div></section></asp:Content>