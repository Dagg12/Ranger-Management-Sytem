<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="TheRanger.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="The Ranger - Your gateway to the wild. Discover safari accommodation and guided game drives." />
    <title><%: Page.Title %> | The Ranger</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="/site.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
<form id="form1" runat="server">
<nav class="navbar navbar-expand-lg navbar-dark ranger-navbar fixed-top" id="mainNavbar">
<div class="container">
<a class="navbar-brand d-flex align-items-center gap-2" href="/Pages/Public/Default.aspx" aria-label="The Ranger home"><span class="brand-mark"><i class="fa-solid fa-leaf"></i></span><span class="brand-name">THE RANGER</span></a>
<button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="mainNav">
<ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
<asp:Panel ID="pnlGuest" runat="server" CssClass="d-flex align-items-lg-center gap-lg-2 flex-column flex-lg-row">
<li class="nav-item"><a class="nav-link" href="/Pages/Public/Default.aspx">Home</a></li>
<li class="nav-item"><a class="nav-link" href="/Pages/Public/Accommodation.aspx">Accommodation</a></li>
<li class="nav-item"><a class="nav-link" href="/Pages/Public/GameDrives.aspx">Game Drives</a></li>
<li class="nav-item"><a class="nav-link" href="/Pages/Public/About.aspx">About</a></li>
<li class="nav-item"><a class="nav-link" href="/Pages/Public/Help.aspx"><i class="fa-regular fa-circle-question me-1"></i> Help</a></li>
<li class="nav-item"><a class="nav-link" href="/Pages/Account/Login.aspx">Login</a></li>
<li class="nav-item ms-lg-2"><a class="nav-link nav-register" href="/Pages/Account/Register.aspx">Register <i class="fa-solid fa-arrow-right ms-2"></i></a></li>
</asp:Panel>
<asp:Panel ID="pnlClient" runat="server" CssClass="d-flex align-items-lg-center gap-lg-2 flex-column flex-lg-row">
<li class="nav-item"><a class="nav-link" href="/Pages/Client/ClientDashboard.aspx">Dashboard</a></li>
<li class="nav-item"><a class="nav-link" href="/Pages/Public/Accommodation.aspx">Accommodation</a></li>
<li class="nav-item"><a class="nav-link" href="/Pages/Public/GameDrives.aspx">Game Drives</a></li>
<li class="nav-item"><a class="nav-link" href="/Pages/Client/ClientDashboard.aspx#bookings">My Bookings</a></li>
<li class="nav-item"><a class="nav-link" href="/Pages/Public/Help.aspx"><i class="fa-regular fa-circle-question me-1"></i> Help</a></li>
<li class="nav-item account-pill"><span><i class="fa-solid fa-user"></i> <asp:Literal ID="litAccountName" runat="server" /></span></li>
<li class="nav-item"><asp:LinkButton ID="btnMasterLogout" runat="server" CssClass="nav-link" OnClick="btnMasterLogout_Click">Logout</asp:LinkButton></li>
</asp:Panel>
<asp:Panel ID="pnlOwner" runat="server" CssClass="d-flex align-items-lg-center gap-lg-2 flex-column flex-lg-row">
<li class="nav-item"><a class="nav-link" href="/Pages/Owner/OwnerDashboard.aspx">Dashboard</a></li>
<li class="nav-item"><a class="nav-link" href="/Pages/Owner/OwnerAccommodation.aspx">Accommodation</a></li>
<li class="nav-item"><a class="nav-link" href="/Pages/Owner/OwnerGameDrives.aspx">Game Drives</a></li>
<li class="nav-item"><a class="nav-link" href="/Pages/Owner/OwnerBookings.aspx">Bookings</a></li>
<li class="nav-item"><a class="nav-link" href="/Pages/Public/Help.aspx"><i class="fa-regular fa-circle-question me-1"></i> Help</a></li>
<li class="nav-item account-pill"><span><i class="fa-solid fa-user-tie"></i> <asp:Literal ID="litAccountName2" runat="server" /></span></li>
<li class="nav-item"><asp:LinkButton ID="btnOwnerLogout" runat="server" CssClass="nav-link" OnClick="btnMasterLogout_Click">Logout</asp:LinkButton></li>
</asp:Panel>
</ul></div></div></nav>
<main><asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder></main>
<footer class="site-footer"><div class="container"><div class="row g-5 align-items-start"><div class="col-lg-5"><a href="/Pages/Public/Default.aspx" class="footer-brand"><span class="brand-mark"><i class="fa-solid fa-leaf"></i></span><span>THE RANGER</span></a><p class="footer-tagline">Your gateway to the wild.</p><p class="footer-copy-text">Discover unforgettable safari experiences, comfortable stays and guided adventures in the African wilderness.</p></div><div class="col-6 col-lg-2"><h6 class="footer-title">Explore</h6><a href="/Pages/Public/Default.aspx">Home</a><a href="/Pages/Public/Accommodation.aspx">Accommodation</a><a href="/Pages/Public/GameDrives.aspx">Game Drives</a></div><div class="col-6 col-lg-2"><h6 class="footer-title">Account</h6><a href="/Pages/Account/Login.aspx">Login</a><a href="/Pages/Account/Register.aspx">Client Registration</a><a href="/Pages/Public/About.aspx">About</a></div><div class="col-lg-3"><h6 class="footer-title">The Wild Awaits</h6><p class="footer-small">Plan your next adventure with The Ranger.</p><a href="/Pages/Public/Accommodation.aspx" class="footer-cta">Start Exploring <i class="fa-solid fa-arrow-right"></i></a></div></div><div class="footer-bottom"><span>&copy; 2026 The Ranger. All rights reserved.</span><span>Safari Management System</span></div></div></footer>
</form>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>(function(){const navbar=document.getElementById('mainNavbar');window.addEventListener('scroll',function(){navbar.classList.toggle('scrolled',window.scrollY>30);});document.querySelectorAll('#mainNav .nav-link').forEach(function(link){link.addEventListener('click',function(){const menu=document.getElementById('mainNav');if(menu.classList.contains('show'))bootstrap.Collapse.getOrCreateInstance(menu).hide();});});})();</script>
</body></html>
