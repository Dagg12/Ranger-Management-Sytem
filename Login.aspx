<%@ Page Title="Login" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Login.aspx.cs" Inherits="TheRanger.Login" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server">
    <style>.auth-page{min-height:calc(100vh - 90px);display:flex;align-items:center;background:linear-gradient(135deg,#f5f0e7,#eef2ec)}.auth-card{max-width:470px;margin:auto;border:0;border-radius:24px;box-shadow:0 20px 60px rgba(20,42,31,.14);overflow:hidden}.auth-top{background:#173b2b;color:white;padding:38px}.auth-body{padding:34px}.form-control{border-radius:12px;padding:.8rem 1rem}.auth-btn{background:#b68a45;color:#fff;border:0;border-radius:12px;padding:.85rem;font-weight:700}.auth-btn:hover{background:#967036;color:#fff}.auth-link{color:#173b2b;font-weight:700;text-decoration:none}.error-text{color:#a33a2b;font-size:.9rem}</style>
</asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server">
<section class="auth-page py-5"><div class="container"><div class="auth-card bg-white"><div class="auth-top"><div class="small text-uppercase opacity-75 mb-2">Welcome back</div><h1 class="font-display mb-2">Enter the wild.</h1><p class="mb-0 opacity-75">Sign in to manage your safari journey.</p></div><div class="auth-body"><asp:Label ID="lblMessage" runat="server" CssClass="error-text d-block mb-3"></asp:Label><div class="mb-3"><label class="form-label fw-semibold">Email address</label><asp:TextBox ID="txtEmail" runat="server" CssClass="form-control" TextMode="Email" placeholder="you@example.com"></asp:TextBox></div><div class="mb-4"><label class="form-label fw-semibold">Password</label><asp:TextBox ID="txtPassword" runat="server" CssClass="form-control" TextMode="Password" placeholder="Enter your password"></asp:TextBox></div><asp:Button ID="btnLogin" runat="server" Text="Sign In" CssClass="btn auth-btn w-100" OnClick="btnLogin_Click" /><div class="text-center mt-4"><span>New to The Ranger?</span> <a class="auth-link" href="Register.aspx">Create a client account</a></div></div></div></div></section>
</asp:Content>
