<%@ Page Title="Client Registration" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Register.aspx.cs" Inherits="TheRanger.Register" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><style>.auth-page{min-height:calc(100vh - 90px);display:flex;align-items:center;background:linear-gradient(135deg,#f5f0e7,#eef2ec)}.auth-card{max-width:760px;margin:auto;border:0;border-radius:24px;box-shadow:0 20px 60px rgba(20,42,31,.14);overflow:hidden}.auth-top{background:#173b2b;color:white;padding:34px}.auth-body{padding:34px}.form-control{border-radius:12px;padding:.8rem 1rem}.auth-btn{background:#b68a45;color:#fff;border:0;border-radius:12px;padding:.85rem;font-weight:700}.auth-btn:hover{background:#967036;color:#fff}.auth-link{color:#173b2b;font-weight:700;text-decoration:none}.error-text{color:#a33a2b;font-size:.9rem}.success-text{color:#276749;font-size:.9rem}</style></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server"><section class="auth-page py-5"><div class="container"><div class="auth-card bg-white"><div class="auth-top"><div class="small text-uppercase opacity-75 mb-2">Client registration</div><h1 class="font-display mb-2">Begin your adventure.</h1><p class="mb-0 opacity-75">Create your client account and start exploring The Ranger.</p></div><div class="auth-body"><asp:Label ID="lblMessage" runat="server" CssClass="d-block mb-3"></asp:Label><div class="row g-3"><div class="col-md-6"><label class="form-label fw-semibold">First name</label><asp:TextBox ID="txtFirstName" runat="server" CssClass="form-control" /></div><div class="col-md-6"><label class="form-label fw-semibold">Last name</label><asp:TextBox ID="txtLastName" runat="server" CssClass="form-control" /></div><div class="col-md-6"><label class="form-label fw-semibold">Email address</label><asp:TextBox ID="txtEmail" runat="server" CssClass="form-control" TextMode="Email" /></div><div class="col-md-6"><label class="form-label fw-semibold">Phone</label><asp:TextBox ID="txtPhone" runat="server" CssClass="form-control" /></div><div class="col-md-6"><label class="form-label fw-semibold">Password</label><asp:TextBox ID="txtPassword" runat="server" CssClass="form-control" TextMode="Password" /></div><div class="col-md-6"><label class="form-label fw-semibold">Confirm password</label><asp:TextBox ID="txtConfirm" runat="server" CssClass="form-control" TextMode="Password" /></div></div><div class="mt-4"><asp:Button ID="btnRegister" runat="server" Text="Create Client Account" CssClass="btn auth-btn w-100" OnClick="btnRegister_Click" /></div><div class="text-center mt-4">Already have an account? <a class="auth-link" href="Login.aspx">Sign in</a></div></div></div></div></section></asp:Content>
