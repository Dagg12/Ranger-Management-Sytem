<%@ Page Title="Help & User Manual" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Help.aspx.cs" Inherits="TheRanger.Help" %>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server">
<section class="page-hero"><div class="container"><div class="page-kicker">USER MANUAL</div><h1 class="page-title">Help &amp; How The Ranger Works</h1><p class="mb-0 opacity-75">A quick guide to finding stays, booking experiences and managing safari operations.</p></div></section>
<section class="page-shell"><div class="container"><asp:Panel ID="pnlClientHelp" runat="server" Visible="false"><div class="surface p-4 p-lg-5 mb-4"><h2 class="font-display">Client guide</h2><ol class="mb-0"><li class="mb-2"><strong>Find an experience:</strong> use Accommodation or Game Drives and filter by location, guests and other available options.</li><li class="mb-2"><strong>Open a card:</strong> select Book to see the full details, dates and live estimated total.</li><li class="mb-2"><strong>Accommodation total:</strong> nights × nightly rate. For example, 2 nights at R4,000.00 = R8,000.00.</li><li class="mb-2"><strong>Game-drive total:</strong> guests × drive price.</li><li class="mb-2"><strong>Track bookings:</strong> Client Dashboard shows your bookings, totals and statuses. Pending and Confirmed bookings can be cancelled where permitted.</li></ol></div></asp:Panel>
<asp:Panel ID="pnlOwnerHelp" runat="server" Visible="false"><div class="surface p-4 p-lg-5 mb-4"><h2 class="font-display">Owner guide</h2><ol class="mb-0"><li class="mb-2"><strong>Manage inventory:</strong> add or edit accommodation and game drives, set availability, location, capacity, pricing and images.</li><li class="mb-2"><strong>Images:</strong> choose an existing Ranger image or upload a new supported image when adding/updating an experience.</li><li class="mb-2"><strong>Bookings:</strong> use Bookings &amp; Reports to filter reservations. The table shows only records matching the selected filters.</li><li class="mb-2"><strong>Reports:</strong> select a report type, apply filters, click Preview Report to review the exact filtered results on screen, then Download PDF.</li><li class="mb-2"><strong>Status:</strong> update a booking from Pending, Confirmed, Cancelled or Completed and save with Update.</li></ol></div></asp:Panel>
<div class="surface p-4"><h3 class="font-display">Common tips</h3><ul class="mb-0"><li>Clear filters to return to all available results.</li><li>Use the location dropdown rather than typing a location when a dropdown is provided.</li><li>All money values are displayed with cents, e.g. <strong>R 8,000.00</strong>.</li><li>If a booking date is unavailable, choose another date shown as available by the system.</li></ul></div></div></section>
</asp:Content>
