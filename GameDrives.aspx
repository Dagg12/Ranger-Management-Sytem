<%@ Page Title="Game Drives" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="GameDrives.aspx.cs" Inherits="TheRanger.GameDrives" %>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server"><section class="page-hero"><div class="container"><div class="page-kicker">FOLLOW THE TRACKS</div><h1 class="page-title">Guided Game Drives</h1><p class="mb-0 opacity-75">Choose a real safari experience, pick your date and reserve your seats.</p></div></section><section class="page-shell"><div class="container"><div class="surface p-3 mb-4"><div class="row g-2"><div class="col-lg-5"><asp:TextBox ID="txtSearch" runat="server" CssClass="form-control" placeholder="Search drives by name or location..."></asp:TextBox></div><div class="col-md-4 col-lg-2"><asp:DropDownList ID="ddlLocation" runat="server" CssClass="form-select"></asp:DropDownList></div><div class="col-md-4 col-lg-2"><asp:DropDownList ID="ddlGuests" runat="server" CssClass="form-select"><asp:ListItem Value="0">Any guests</asp:ListItem><asp:ListItem Value="1">1+ guests</asp:ListItem><asp:ListItem Value="2">2+ guests</asp:ListItem><asp:ListItem Value="4">4+ guests</asp:ListItem><asp:ListItem Value="6">6+ guests</asp:ListItem><asp:ListItem Value="8">8+ guests</asp:ListItem></asp:DropDownList></div><div class="col-md-4 col-lg-2"><asp:DropDownList ID="ddlSort" runat="server" CssClass="form-select"><asp:ListItem Value="name">Name</asp:ListItem><asp:ListItem Value="price_low">Price: Low to High</asp:ListItem><asp:ListItem Value="price_high">Price: High to Low</asp:ListItem><asp:ListItem Value="duration">Duration</asp:ListItem></asp:DropDownList></div><div class="col-md-4 col-lg-3"><asp:Button ID="btnSearch" runat="server" Text="Apply filters" CssClass="btn btn-ranger w-100" OnClick="btnSearch_Click" /></div></div></div><div class="row g-4"><asp:Repeater ID="rptDrives" runat="server"><ItemTemplate><div class="col-md-6 col-xl-4"><article class="listing-card"><div class="listing-image" style='background-image:linear-gradient(0deg,rgba(10,25,17,.55),transparent),url("<%# Eval("image_url") %>")'></div><div class="listing-body"><span class="badge-soft"><i class="fa-solid fa-location-dot me-1"></i><%# Eval("location") %></span><h3 class="h4 mt-2"><%# Eval("drive_name") %></h3><p class="muted small"><%# Eval("description") %></p><div class="d-flex justify-content-between mb-3"><div><div class="price">R <%# Eval("price","{0:N2}") %></div><small class="muted">per guest</small></div><div class="text-end"><small class="muted d-block"><%# Eval("duration_hours") %> hrs</small><small class="muted"><%# Eval("max_guests") %> seats</small></div></div><a class="btn btn-ranger w-100" href='GameDriveBooking.aspx?id=<%# Eval("game_drive_id") %>'>View &amp; book <i class="fa-solid fa-arrow-right ms-1"></i></a></div></article></div></ItemTemplate></asp:Repeater></div><asp:Panel ID="pnlEmpty" runat="server" Visible="false" CssClass="surface p-5 text-center mt-4"><h4 class="font-display">No game drives found</h4><p class="muted">Try another location, guest capacity or search term.</p></asp:Panel></div></section></asp:Content>
