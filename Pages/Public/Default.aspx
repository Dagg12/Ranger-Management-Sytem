<%@ Page Title="Home" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Default.aspx.cs" Inherits="TheRanger.Default" %>
<asp:Content ID="ContentHead" ContentPlaceHolderID="head" runat="server"><style>.hero{background-image:url('/Images/hero-safari.jpg')}.intro-image{background-image:url('/Images/wilderness.jpg')}.experience-card .card-image{position:relative;overflow:hidden}.experience-card .card-slides{position:absolute;inset:0}.experience-card .card-slide{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .8s ease}.experience-card .card-slide.active{opacity:1}.experience-card .card-image::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(8,22,15,.55),rgba(8,22,15,.05) 70%);z-index:1}.experience-card .card-number,.experience-card .card-icon{z-index:2}</style></asp:Content>
<asp:Content ID="ContentMain" ContentPlaceHolderID="MainContent" runat="server"><section class="hero"><div class="hero-overlay"></div><div class="hero-glow"></div><div class="container hero-inner"><div class="hero-content"><div class="eyebrow"><span></span> AUTHENTIC AFRICAN ADVENTURES</div><h1>THE<br /><em>RANGER</em></h1><p class="hero-tagline">Your gateway to the wild.</p><p class="hero-description">Discover unforgettable safari experiences, comfortable accommodation and guided game drives in the heart of the African wilderness.</p><div class="hero-actions"><a href="/Pages/Public/Accommodation.aspx" class="btn ranger-btn ranger-btn-primary">Explore Accommodation <i class="fa-solid fa-arrow-right"></i></a><a href="/Pages/Public/GameDrives.aspx" class="btn ranger-btn ranger-btn-ghost">Discover Game Drives <i class="fa-solid fa-binoculars"></i></a></div></div><div class="hero-scroll"><span>SCROLL TO EXPLORE</span><i class="fa-solid fa-arrow-down"></i></div><div class="hero-badge d-none d-md-flex"><span class="badge-icon"><i class="fa-solid fa-compass"></i></span><div><strong>WILD. SIMPLE. MEMORABLE.</strong><small>Your next adventure starts here.</small></div></div></div></section><section class="intro-section section-pad" id="about"><div class="container"><div class="row align-items-center g-5"><div class="col-lg-6"><div class="section-kicker">THE RANGER EXPERIENCE</div><h2 class="section-title">Experience the Wild <span>Differently</span></h2><div class="gold-line"></div><p class="section-lead">The Ranger connects guests with memorable safari experiences, carefully selected accommodation and exciting guided game drives.</p><p class="section-body">Explore the wilderness, discover incredible wildlife and create memories that last a lifetime. From finding your ideal stay to choosing your next game drive, everything is designed to make planning your safari simple.</p><a href="/Pages/Public/Accommodation.aspx" class="text-link">Explore the experience <i class="fa-solid fa-arrow-right"></i></a></div><div class="col-lg-6"><div class="intro-visual"><div class="intro-image"></div><div class="visual-card"><span class="visual-icon"><i class="fa-solid fa-location-dot"></i></span><div><strong>Into the Wild</strong><small>Where every drive tells a story.</small></div></div><div class="visual-number">01</div></div></div></div></div></section><section class="experience-section section-pad" id="features"><div class="container"><div class="section-header-row"><div><div class="section-kicker">DISCOVER YOUR ADVENTURE</div><h2 class="section-title">Everything you need to <span>explore</span></h2></div><p>Choose your experience and let The Ranger take you closer to the wild.</p></div><div class="row g-4 mt-2"><div class="col-md-4"><article class="experience-card"><div class="card-image"><div class="card-slides" data-slide-delay="3200"><img class="card-slide active" src="/Images/A1.jpg" alt="Safari accommodation" /><img class="card-slide" src="/Images/A2.jpg" alt="Safari accommodation" /><img class="card-slide" src="/Images/A3.jpg" alt="Safari accommodation" /></div><span class="card-number">01</span><span class="card-icon"><i class="fa-solid fa-house"></i></span></div><div class="card-content"><div class="card-kicker">STAY</div><h3>Safari Accommodation</h3><p>Find comfortable accommodation surrounded by the beauty of the African wilderness.</p><a href="/Pages/Public/Accommodation.aspx" class="card-link">Explore Accommodation <i class="fa-solid fa-arrow-right"></i></a></div></article></div><div class="col-md-4" id="game-drives"><article class="experience-card"><div class="card-image"><div class="card-slides" data-slide-delay="3600"><img class="card-slide active" src="/Images/D1.jpg" alt="Guided game drive" /><img class="card-slide" src="/Images/D2.jpg" alt="Guided game drive" /><img class="card-slide" src="/Images/D3.jpg" alt="Guided game drive" /></div><span class="card-number">02</span><span class="card-icon"><i class="fa-solid fa-binoculars"></i></span></div><div class="card-content"><div class="card-kicker">ADVENTURE</div><h3>Guided Game Drives</h3><p>Join exciting guided game drives and experience Africa's wildlife up close.</p><a href="/Pages/Public/GameDrives.aspx" class="card-link">Explore Game Drives <i class="fa-solid fa-arrow-right"></i></a></div></article></div><div class="col-md-4"><article class="experience-card"><div class="card-image"><div class="card-slides" data-slide-delay="3000"><img class="card-slide active" src="/Images/Golden Hour Safari.jpg" alt="Safari sunset" /><img class="card-slide" src="/Images/Night Safari Experience.jpg" alt="Night safari" /><img class="card-slide" src="/Images/Sunrise Wildlife Drive.jpg" alt="Sunrise wildlife drive" /></div><span class="card-number">03</span><span class="card-icon"><i class="fa-solid fa-calendar-check"></i></span></div><div class="card-content"><div class="card-kicker">PLAN</div><h3>Easy Booking</h3><p>Book your accommodation and safari experiences quickly and conveniently.</p><a href="/Pages/Public/Accommodation.aspx" class="card-link">Start Exploring <i class="fa-solid fa-arrow-right"></i></a></div></article></div></div></div></section><section class="why-section section-pad"><div class="container"><div class="text-center section-heading-centered"><div class="section-kicker">WHY THE RANGER</div><h2 class="section-title">Made for the <span>wild at heart</span></h2><p>Simple tools. Memorable experiences. A smarter way to plan your safari.</p></div><div class="row g-3 mt-4"><div class="col-6 col-lg-3"><div class="why-card"><span><i class="fa-solid fa-tree"></i></span><h3>Authentic Safari Experiences</h3><p>Discover experiences built around the beauty of the wilderness.</p></div></div><div class="col-6 col-lg-3"><div class="why-card"><span><i class="fa-solid fa-house-chimney"></i></span><h3>Comfortable Accommodation</h3><p>Find a welcoming place to rest between your adventures.</p></div></div><div class="col-6 col-lg-3"><div class="why-card"><span><i class="fa-solid fa-route"></i></span><h3>Guided Game Drives</h3><p>Explore with guided drives designed to bring you closer to nature.</p></div></div><div class="col-6 col-lg-3"><div class="why-card"><span><i class="fa-solid fa-calendar-check"></i></span><h3>Simple Online Booking</h3><p>Plan your stay and safari activities without unnecessary complexity.</p></div></div></div></div></section><section class="cta-section" id="cta"><div class="cta-bg"></div><div class="container position-relative"><div class="cta-content text-center"><div class="section-kicker light">YOUR NEXT ADVENTURE</div><h2>Ready to Explore <span>the Wild?</span></h2><p>Your next adventure begins here.</p><a href="/Pages/Public/Accommodation.aspx" class="btn ranger-btn ranger-btn-sand">Start Your Safari <i class="fa-solid fa-arrow-right"></i></a></div></div></section><script>(function(){function startSlides(){document.querySelectorAll('.card-slides').forEach(function(slides){var imgs=slides.querySelectorAll('.card-slide');if(imgs.length<2)return;var index=0,delay=parseInt(slides.getAttribute('data-slide-delay')||'3200',10);setInterval(function(){imgs[index].classList.remove('active');index=(index+1)%imgs.length;imgs[index].classList.add('active');},delay);});}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',startSlides);else startSlides();})();</script></asp:Content>