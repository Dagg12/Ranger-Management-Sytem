<%@ Page Title="Accommodation" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Accommodation.aspx.cs" Inherits="TheRanger.Accommodation" %><asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"></asp:Content><asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server"><section class="page-hero"><div class="container"><div class="page-kicker">STAY IN THE WILD</div><h1 class="page-title">Safari Accommodation</h1><p class="mb-0 opacity-75">Browse comfortable stays and choose the right base for your adventure.</p></div></section><section class="page-shell"><div class="container"><div class="surface p-3 mb-4"><div class="row g-2 align-items-center"><div class="col-lg-4"><asp:TextBox ID="txtSearch" runat="server" CssClass="form-control" placeholder="Search by name, location or room type..."></asp:TextBox></div><div class="col-md-4 col-lg-2"><asp:DropDownList ID="ddlLocation" runat="server" CssClass="form-select"></asp:DropDownList></div><div class="col-md-4 col-lg-2"><asp:DropDownList ID="ddlGuests" runat="server" CssClass="form-select"><asp:ListItem Value="0">Any guests</asp:ListItem><asp:ListItem Value="1">1+ guests</asp:ListItem><asp:ListItem Value="2">2+ guests</asp:ListItem><asp:ListItem Value="4">4+ guests</asp:ListItem><asp:ListItem Value="6">6+ guests</asp:ListItem><asp:ListItem Value="8">8+ guests</asp:ListItem></asp:DropDownList></div><div class="col-md-4 col-lg-2"><asp:DropDownList ID="ddlSort" runat="server" CssClass="form-select"><asp:ListItem Value="name">Name</asp:ListItem><asp:ListItem Value="price_low">Price: Low to High</asp:ListItem><asp:ListItem Value="price_high">Price: High to Low</asp:ListItem><asp:ListItem Value="guests">Guest Capacity</asp:ListItem></asp:DropDownList></div><div class="col-md-4 col-lg-2"><asp:Button ID="btnSearch" runat="server" Text="Apply filters" CssClass="btn btn-ranger w-100" OnClick="btnSearch_Click" /></div></div></div><asp:Label ID="lblMessage" runat="server" CssClass="text-danger"></asp:Label><div class="row g-4 mt-1"><asp:Repeater ID="rptAccommodation" runat="server"><ItemTemplate><div class="col-md-6 col-xl-4"><article class="listing-card"><div class="listing-image" style='background-image:linear-gradient(0deg,rgba(10,25,17,.5),transparent),url("<%# Eval("image_url") %>")'></div><div class="listing-body"><span class="badge-soft mb-2"><i class="fa-solid fa-location-dot me-1"></i><%# Eval("location") %></span><h3 class="h4 mt-2"><%# Eval("accommodation_name") %></h3><p class="muted small"><%# Eval("description") %></p><div class="d-flex justify-content-between align-items-end mb-3"><div><div class="price">R <%# Eval("price_per_night","{0:N2}") %></div><small class="muted">per night</small></div><small class="muted"><i class="fa-solid fa-users me-1"></i> Up to <%# Eval("max_guests") %></small></div><a class="btn btn-ranger w-100" href='/Pages/Client/AccommodationBooking.aspx?id=<%# Eval("accommodation_id") %>'>View &amp; book <i class="fa-solid fa-arrow-right ms-1"></i></a></div></article></div></ItemTemplate></asp:Repeater><asp:Panel ID="pnlEmpty" runat="server" Visible="false" CssClass="col-12 surface p-5 text-center"><h4 class="font-display">No accommodation found</h4><p class="muted">Try a different location, search term or guest capacity.</p></asp:Panel></div></div></section></asp:Content>